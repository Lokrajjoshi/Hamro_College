# Copy this file to .env.local and fill in values.
# The site works WITHOUT these — it falls back to the built-in data in /data.

# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used by `npm run seed` on your own machine. Never add this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed URL (used for sitemap.xml and SEO tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
